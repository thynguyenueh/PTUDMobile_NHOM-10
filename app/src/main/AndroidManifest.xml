<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập Internet cho Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentHousing">

        <!-- LoginActivity = màn hình mở đầu -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình chính (Hồ sơ) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Đăng ký -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterStep2Activity"
            android:exported="false" />

        <!-- Đánh giá -->
        <activity
            android:name=".ReviewActivity"
            android:exported="false" />

        <!-- Chat -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- KYC -->
        <activity
            android:name=".KycActivity"
            android:exported="false" />

        <!-- TV3 — studenthousing -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <activity
            android:name=".DetailActivity"
            android:exported="false" />

        <activity
            android:name=".ProposalActivity"
            android:exported="false" />

        <activity
            android:name=".ResidenceVerificationActivity"
            android:exported="false" />

        <activity
            android:name=".SearchFilterActivity"
            android:exported="false" />

    </application>

</manifest>