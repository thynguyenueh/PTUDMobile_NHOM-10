<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentHousing">

        <!-- Login = màn hình mở đầu -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hồ sơ -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterStep2Activity"
            android:exported="false" />

        <activity
            android:name=".ReviewActivity"
            android:exported="false" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- TV3 — homeexchange (dùng tên đầy đủ vì khác package) -->
        <activity
            android:name="com.example.homeexchange.HomeActivity"
            android:exported="false" />

        <activity
            android:name="com.example.homeexchange.DetailActivity"
            android:exported="false" />

        <activity
            android:name="com.example.homeexchange.ProposalActivity"
            android:exported="false" />

    </application>

</manifest>