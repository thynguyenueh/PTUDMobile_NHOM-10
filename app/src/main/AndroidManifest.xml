<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập Internet cho Firebase và thông báo -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".StudentHousingApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentHousing">

        <!-- LoginActivity = màn hình mở đầu -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>



        <!-- Đăng ký -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <!-- KYC -->
        <activity
            android:name=".ui.verify.KycActivity"
            android:exported="false" />

        <!-- TV3 — studenthousing -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.post.DetailActivity"
            android:exported="false" />



        <!-- ⚠️ TẠM đổi true để test bằng adb -->
        <activity
            android:name=".ui.verify.ResidenceVerificationActivity"
            android:exported="true" />

        <activity
            android:name=".ui.home.SearchFilterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.SearchResultsActivity"
            android:exported="false" />





        <activity
            android:name=".ui.post.MyPostsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.post.SavedHousesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.post.CreatePostActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.PublicHostProfileActivity"
            android:exported="false" />

    </application>

</manifest>