<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentHousing">

        <!-- Màn hình Đăng nhập (Màn hình chính khi khởi chạy ứng dụng) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình Đăng ký Step 1: Thông tin cơ bản -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Màn hình Đăng ký Step 2: Thông tin Chỗ ở -->
        <activity
            android:name=".RegisterStep2Activity"
            android:exported="false" />

        <!-- Màn hình trang chủ Trang chính -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>