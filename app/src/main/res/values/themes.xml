<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HomeExchange" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/olive_green</item>
        <item name="colorOnPrimary">@color/card_bg</item>
        <item name="colorSurface">@color/cloud_olive</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="android:windowBackground">@color/cloud_olive</item>
        <item name="android:colorBackground">@color/cloud_olive</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
        <item name="android:statusBarColor">@color/cloud_olive</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/olive_green</item>
        <item name="android:textColor">@color/card_bg</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.App.Button.Primary">
        <item name="backgroundTint">@color/dusty_olive</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="iconTint">@color/text_main</item>
    </style>

    <style name="Widget.App.Button.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/toggle_background</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.App.Image12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
