<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================ -->
    <!-- APP BAR / HEADER                              -->
    <!-- ============================================ -->
    <style name="Widget.App.HeaderBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:background">@color/surface_card</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
    </style>

    <style name="Widget.App.HeaderBackButton" parent="">
        <item name="android:layout_width">@dimen/touch_target_min</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/space_md</item>
        <item name="android:contentDescription">@string/cd_back</item>
        <item name="android:src">@drawable/ic_arrow_back</item>
        <item name="tint">@color/text_main</item>
    </style>

    <style name="Widget.App.HeaderTitle" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.App.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider_height</item>
        <item name="android:background">@color/divider_line</item>
    </style>

    <!-- ============================================ -->
    <!-- TYPOGRAPHY                                   -->
    <!-- ============================================ -->
    <style name="TextAppearance.App.Caption" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_sub</item>
    </style>

    <style name="TextAppearance.App.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <style name="TextAppearance.App.BodySub" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_sub</item>
    </style>

    <style name="TextAppearance.App.SectionTitle" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <style name="TextAppearance.App.Subtitle" parent="">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <style name="TextAppearance.App.Heading" parent="">
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <!-- ============================================ -->
    <!-- SURFACES / CARDS                             -->
    <!-- ============================================ -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/card_radius_lg</item>
        <item name="cardElevation">@dimen/elevation_low</item>
        <item name="strokeColor">@color/divider_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Card có viền, không đổ bóng: dùng cho khối nội dung lồng nhau -->
    <style name="Widget.App.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/card_radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Card phẳng, tông nền nhẹ: dùng cho banner/notice -->
    <style name="Widget.App.Card.Tinted" parent="Widget.App.Card.Outlined">
        <item name="cardBackgroundColor">@color/bg_input</item>
        <item name="strokeColor">@color/primary</item>
    </style>

    <!-- Card nội dung lồng bên trong card khác (comment box, description) -->
    <style name="Widget.App.Card.Nested" parent="Widget.App.Card.Outlined">
        <item name="cardBackgroundColor">@color/bg_app</item>
    </style>

    <!-- ============================================ -->
    <!-- BADGES / PILLS                               -->
    <!-- ============================================ -->
    <style name="Widget.App.Badge" parent="">
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">@dimen/space_xs</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.App.Badge.Verified" parent="Widget.App.Badge">
        <item name="android:background">@drawable/bg_badge_verified_moss</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- ============================================ -->
    <!-- ICON BUTTONS                                 -->
    <!-- ============================================ -->
    <style name="Widget.App.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_target_min</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/space_md</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Nút tròn nổi trên ảnh (back / favorite) -->
    <style name="Widget.App.IconButton.Overlay" parent="Widget.App.IconButton">
        <item name="android:layout_width">@dimen/icon_btn_size</item>
        <item name="android:layout_height">@dimen/icon_btn_size</item>
        <item name="android:background">@drawable/bg_circle_overlay</item>
        <item name="android:padding">10dp</item>
        <item name="tint">@color/white</item>
    </style>

    <!-- ============================================ -->
    <!-- BUTTONS                                      -->
    <!-- ============================================ -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/card_radius_md</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.App.Button.Primary">
        <item name="backgroundTint">@color/bg_input</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/card_radius_md</item>
        <item name="strokeColor">@color/divider_line</item>
        <item name="iconTint">@color/primary</item>
    </style>

    <style name="Widget.App.Button.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/toggle_background</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">@dimen/card_radius_sm</item>
    </style>

    <!-- Nút chữ phẳng, dùng cho "Xem tất cả", "Xóa" -->
    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <!-- ============================================ -->
    <!-- BOTTOM NAV / CHIPS                           -->
    <!-- ============================================ -->
    <style name="Widget.App.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface_card</item>
        <item name="elevation">@dimen/elevation_high</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipBackgroundColor">@color/bg_input</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <!-- ============================================ -->
    <!-- SHAPES                                       -->
    <!-- ============================================ -->
    <style name="ShapeAppearance.App.Image12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/card_radius_md</item>
    </style>

    <style name="ShapeAppearance.App.Image16" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/card_radius_lg</item>
    </style>

    <!-- ============================================ -->
    <!-- FORM FIELDS (Auth / Settings)                -->
    <!-- ============================================ -->
    <style name="Widget.App.FormField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <style name="Widget.App.FormInput" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
    </style>

    <style name="Widget.App.LinkText" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:padding">@dimen/space_sm</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
