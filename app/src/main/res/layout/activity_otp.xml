<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface_card"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_lg">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:padding="@dimen/space_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_main" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:text="@string/otp_title"
            android:textColor="@color/text_main"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />
    </LinearLayout>

    <View style="@style/Widget.App.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">

        <!-- Shield Lock Frame -->
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_circle_olive">

            <ImageView
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_lock"
                android:src="@drawable/ic_lock"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/otp_header"
            android:textColor="@color/text_main"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPhoneHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/otp_hint_phone"
            android:textColor="@color/text_sub"
            android:textSize="@dimen/text_body"
            tools:text="Mã xác thực 6 chữ số đã được gửi tới SĐT 0901234567" />

        <!-- Six independent OTP digit slots -->
        <LinearLayout
            android:id="@+id/otpContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText android:id="@+id/otpDigit1" style="@style/Widget.App.FormInput" android:layout_width="0dp" android:layout_height="@dimen/btn_height" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:autofillHints="smsOTPCode" android:gravity="center" android:inputType="number" android:maxLength="6" android:singleLine="true" android:textSize="@dimen/text_display" android:textStyle="bold" android:importantForAutofill="yes" />
            <EditText android:id="@+id/otpDigit2" style="@style/Widget.App.FormInput" android:layout_width="0dp" android:layout_height="@dimen/btn_height" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:gravity="center" android:inputType="number" android:maxLength="6" android:singleLine="true" android:textSize="@dimen/text_display" android:textStyle="bold" />
            <EditText android:id="@+id/otpDigit3" style="@style/Widget.App.FormInput" android:layout_width="0dp" android:layout_height="@dimen/btn_height" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:gravity="center" android:inputType="number" android:maxLength="6" android:singleLine="true" android:textSize="@dimen/text_display" android:textStyle="bold" />
            <EditText android:id="@+id/otpDigit4" style="@style/Widget.App.FormInput" android:layout_width="0dp" android:layout_height="@dimen/btn_height" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:gravity="center" android:inputType="number" android:maxLength="6" android:singleLine="true" android:textSize="@dimen/text_display" android:textStyle="bold" />
            <EditText android:id="@+id/otpDigit5" style="@style/Widget.App.FormInput" android:layout_width="0dp" android:layout_height="@dimen/btn_height" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:gravity="center" android:inputType="number" android:maxLength="6" android:singleLine="true" android:textSize="@dimen/text_display" android:textStyle="bold" />
            <EditText android:id="@+id/otpDigit6" style="@style/Widget.App.FormInput" android:layout_width="0dp" android:layout_height="@dimen/btn_height" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:gravity="center" android:inputType="number" android:maxLength="6" android:singleLine="true" android:textSize="@dimen/text_display" android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/tilOtp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/text_sub" />



        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyOtp"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_sm"
            android:layout_marginTop="@dimen/space_xxl"
            android:text="@string/otp_btn_verify" />

    </LinearLayout>

</LinearLayout>