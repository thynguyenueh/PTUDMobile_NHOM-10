<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <LinearLayout style="@style/Widget.App.HeaderBar">
        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.App.HeaderBackButton"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_back" />

        <TextView
            style="@style/Widget.App.HeaderTitle"
            android:text="@string/otp_title" />
    </LinearLayout>

    <View style="@style/Widget.App.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">

        <FrameLayout
            android:layout_width="@dimen/otp_shield_size"
            android:layout_height="@dimen/otp_shield_size"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_circle_olive">

            <ImageView
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_lock"
                android:src="@drawable/ic_lock"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            style="@style/TextAppearance.App.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/otp_header" />

        <TextView
            android:id="@+id/tvPhoneHint"
            style="@style/TextAppearance.App.BodySub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/otp_hint_phone"
            tools:text="Mã xác thực 6 chữ số đã được gửi tới SĐT 0901234567" />

        <!-- Status error message label -->
        <TextView
            android:id="@+id/tvOtpError"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textColor="@color/status_danger"
            android:visibility="gone"
            tools:text="Vui lòng nhập đủ 6 số OTP" />

        <LinearLayout
            android:id="@+id/otpContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 6 slots: cùng layout, chỉ khác id -->
            <EditText android:id="@+id/otpDigit1" style="@style/Widget.App.FormInput" android:layout_width="0dp" android:layout_height="@dimen/btn_height" android:layout_marginHorizontal="@dimen/space_xxs" android:layout_weight="1" android:autofillHints="smsOTPCode" android:gravity="center" android:importantForAutofill="yes" android:inputType="number" android:maxLength="1" android:singleLine="true" android:textSize="@dimen/text_display" android:textStyle="bold" tools:ignore="LabelFor" />
            <EditText android:id="@+id/otpDigit2" style="@style/Widget.App.FormInput" android:layout_width="0dp" android:layout_height="@dimen/btn_height" android:layout_marginHorizontal="@dimen/space_xxs" android:layout_weight="1" android:gravity="center" android:importantForAutofill="no" android:inputType="number" android:maxLength="1" android:singleLine="true" android:textSize="@dimen/text_display" android:textStyle="bold" tools:ignore="LabelFor,Autofill" />
            <EditText android:id="@+id/otpDigit3" style="@style/Widget.App.FormInput" android:layout_width="0dp" android:layout_height="@dimen/btn_height" android:layout_marginHorizontal="@dimen/space_xxs" android:layout_weight="1" android:gravity="center" android:importantForAutofill="no" android:inputType="number" android:maxLength="1" android:singleLine="true" android:textSize="@dimen/text_display" android:textStyle="bold" tools:ignore="LabelFor,Autofill" />
            <EditText android:id="@+id/otpDigit4" style="@style/Widget.App.FormInput" android:layout_width="0dp" android:layout_height="@dimen/btn_height" android:layout_marginHorizontal="@dimen/space_xxs" android:layout_weight="1" android:gravity="center" android:importantForAutofill="no" android:inputType="number" android:maxLength="1" android:singleLine="true" android:textSize="@dimen/text_display" android:textStyle="bold" tools:ignore="LabelFor,Autofill" />
            <EditText android:id="@+id/otpDigit5" style="@style/Widget.App.FormInput" android:layout_width="0dp" android:layout_height="@dimen/btn_height" android:layout_marginHorizontal="@dimen/space_xxs" android:layout_weight="1" android:gravity="center" android:importantForAutofill="no" android:inputType="number" android:maxLength="1" android:singleLine="true" android:textSize="@dimen/text_display" android:textStyle="bold" tools:ignore="LabelFor,Autofill" />
            <EditText android:id="@+id/otpDigit6" style="@style/Widget.App.FormInput" android:layout_width="0dp" android:layout_height="@dimen/btn_height" android:layout_marginHorizontal="@dimen/space_xxs" android:layout_weight="1" android:gravity="center" android:importantForAutofill="no" android:inputType="number" android:maxLength="1" android:singleLine="true" android:textSize="@dimen/text_display" android:textStyle="bold" tools:ignore="LabelFor,Autofill" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyOtp"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:text="@string/otp_btn_verify" />
    </LinearLayout>
</LinearLayout>