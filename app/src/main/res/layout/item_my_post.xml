<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_review_card"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/avatar_size_md"
                android:layout_height="@dimen/avatar_size_md"
                android:background="@drawable/bg_circle_olive">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_home"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_home"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPostTitle"
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="@dimen/text_body_lg"
                    tools:text="Căn nhà sinh viên gần ĐHQG" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvPostAddress"
            style="@style/TextAppearance.App.BodySub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            tools:text="Địa chỉ: Phường Linh Trung, TP. Thủ Đức, TP. Hồ Chí Minh" />

        <View
            style="@style/Widget.App.Divider"
            android:layout_marginVertical="@dimen/space_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnDeletePost"
                style="@style/Widget.App.ActionText"
                android:textColor="@color/status_danger"
                app:drawableStartCompat="@drawable/ic_delete"
                app:drawableTint="@color/status_danger"
                android:text="@string/action_delete" />

            <TextView
                android:id="@+id/btnEditPost"
                style="@style/Widget.App.ActionText"
                android:layout_marginStart="@dimen/space_xs"
                android:textColor="@color/text_main"
                app:drawableStartCompat="@drawable/ic_edit"
                app:drawableTint="@color/text_main"
                android:text="@string/action_edit" />

            <TextView
                android:id="@+id/btnViewPost"
                style="@style/Widget.App.ActionText"
                android:layout_marginStart="@dimen/space_xs"
                android:textColor="@color/olive_accent"
                app:drawableStartCompat="@drawable/ic_eye"
                app:drawableTint="@color/olive_accent"
                android:text="@string/action_view" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>