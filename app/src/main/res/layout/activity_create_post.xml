<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <LinearLayout style="@style/Widget.App.HeaderBar">
        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.App.HeaderBackButton" />

        <TextView
            style="@style/Widget.App.HeaderTitle"
            android:text="@string/create_post_title" />
    </LinearLayout>

    <View style="@style/Widget.App.Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/create_post_label_photo" />

                <TextView
                    android:id="@+id/tvPhotoCount"
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_small_lg"
                    android:visibility="gone"
                    tools:text="3 ảnh đã chọn" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSelectedPhotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAddPhoto"
                style="@style/Widget.App.Card.Tinted"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="@dimen/space_sm"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_xl"
                        android:layout_height="@dimen/icon_xl"
                        android:contentDescription="@string/cd_camera"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tvPhotoHint"
                        style="@style/TextAppearance.App.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textColor="@color/primary"
                        android:text="@string/create_post_hint_photo_click" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/create_post_label_title" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTitle"
                style="@style/Widget.App.FormField"
                android:layout_marginTop="@dimen/space_xs">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTitle"
                    style="@style/Widget.App.FormInput"
                    android:hint="@string/create_post_hint_title"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="Địa chỉ *" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAdminAddress"
                style="@style/Widget.App.FormField"
                android:layout_marginTop="@dimen/space_xs"
                app:endIconDrawable="@drawable/ic_chevron_right"
                app:endIconMode="custom"
                app:startIconTint="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAdminAddress"
                    style="@style/Widget.App.FormInput"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Bấm để chọn địa chỉ đã xác thực"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvVerifyAddressPrompt"
                style="@style/TextAppearance.App.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Chưa có địa chỉ nào được xác thực? Bấm vào đây để xác thực ngay"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutManualAddressFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/create_post_label_house_number" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilHouseNumber"
                    style="@style/Widget.App.FormField"
                    android:layout_marginTop="@dimen/space_xs">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHouseNumber"
                        style="@style/Widget.App.FormInput"
                        android:hint="@string/create_post_hint_house_number"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/create_post_label_street_name" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilStreetAddress"
                    style="@style/Widget.App.FormField"
                    android:layout_marginTop="@dimen/space_xs">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStreetAddress"
                        style="@style/Widget.App.FormInput"
                        android:hint="@string/create_post_hint_street_name"
                        android:inputType="textPostalAddress" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/create_post_label_utilities" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupUtilities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.App.FormField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomUtility"
                        style="@style/Widget.App.FormInput"
                        android:hint="@string/create_post_hint_custom_util"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCustomUtility"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/create_post_btn_add_util" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/create_post_label_desc" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.FormField"
                android:layout_marginTop="@dimen/space_xs">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    style="@style/Widget.App.FormInput"
                    android:gravity="top|start"
                    android:hint="@string/create_post_hint_desc"
                    android:inputType="textMultiLine"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:padding="@dimen/space_lg">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitPost"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/create_post_btn_submit"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_sm" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="@dimen/space_lg"
                android:indeterminateTint="@color/surface_card"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
