<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <LinearLayout style="@style/Widget.App.HeaderBar">
        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.App.HeaderBackButton" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/Widget.App.HeaderTitle"
            android:text="@string/reviews_received_title" />
    </LinearLayout>

    <View style="@style/Widget.App.Divider" />

    <View style="@style/Widget.App.Divider" />

    <TextView
        android:id="@+id/tvReviewsState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_lg"
        android:textColor="@color/text_sub"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUserReviews"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/space_lg" />

    <FrameLayout
        android:id="@+id/containerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/layoutBottomAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="@dimen/space_lg"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/btnWriteReview"
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body_lg2"
                android:text="@string/reviews_btn_write" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>