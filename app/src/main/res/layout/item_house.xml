<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_sm"
    android:layout_marginBottom="@dimen/space_lg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_photo_lg">

            <ImageView
                android:id="@+id/ivHousePhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_photo"
                android:scaleType="centerCrop"
                tools:src="@drawable/bg_image_placeholder" />

            <ImageView
                android:id="@+id/ivHouseVerified"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_md"
                android:background="@drawable/bg_badge_verified"
                android:contentDescription="@string/post_address_verified"
                android:padding="@dimen/space_xs"
                android:src="@drawable/ic_verified_check"
                android:visibility="gone"
                app:tint="@color/olive_primary_dark"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView
                android:id="@+id/tvHouseTitle"
                style="@style/TextAppearance.App.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Căn hộ mini cao cấp gần ĐHQG" />

            <TextView
                android:id="@+id/tvHouseAddress"
                style="@style/TextAppearance.App.BodySub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Phường Linh Trung, Thủ Đức" />

            <TextView
                android:id="@+id/tvHouseTime"
                style="@style/TextAppearance.App.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="2 giờ trước" />

            <TextView
                android:id="@+id/tvHouseDistance"
                style="@style/TextAppearance.App.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:drawablePadding="@dimen/space_xs"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_graduation_cap"
                app:drawableTint="@color/primary"
                tools:text="Gần ĐHQG TP.HCM · ~1,5 km"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvHouseUtilities"
                style="@style/TextAppearance.App.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                tools:text="Wi-Fi · Máy lạnh · +2"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>