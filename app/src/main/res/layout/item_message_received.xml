<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bubble_received"
        android:orientation="vertical"
        android:maxWidth="280dp"
        android:padding="4dp">

        <ImageView
            android:id="@+id/ivMessageImage"
            android:layout_width="220dp"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@string/cd_message_image"
            tools:src="@drawable/bg_image_placeholder"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:visibility="visible"
            tools:text="Dạ em chào cô, tuần sau em qua xem nhà được không ạ?" />
    </LinearLayout>
</LinearLayout>