<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_lg"
    android:paddingVertical="@dimen/space_md">

    <TextView
        android:id="@+id/tvChatAvatar"
        style="@style/Widget.App.AvatarCircle.Large"
        tools:text="M" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvChatTitle"
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="@dimen/text_body_lg"
                tools:text="Hộ gia đình đối tác" />

            <ImageView
                android:id="@+id/ivVerifiedBadge"
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:layout_marginStart="@dimen/space_xs"
                android:contentDescription="@string/cd_verified"
                android:src="@drawable/ic_verified_check"
                app:tint="@color/primary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHouseTitle"
            style="@style/TextAppearance.App.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_small_lg"
            android:visibility="gone"
            tools:text="Căn hộ cao cấp Thảo Điền" />

        <TextView
            android:id="@+id/tvChatLastMessage"
            style="@style/TextAppearance.App.BodySub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/text_small_lg"
            tools:text="Dạ em chào cô, tuần sau em qua xem nhà được không ạ?" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChatTime"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_small"
            android:textColor="@color/text_muted"
            tools:text="10:30" />

        <TextView
            android:id="@+id/tvUnreadBadge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_circle_olive"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="1"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>