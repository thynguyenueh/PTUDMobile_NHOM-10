<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:maxWidth="@dimen/chat_bubble_max_width">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMessageImage"
            android:layout_width="220dp"
            android:layout_height="@dimen/card_photo_height"
            android:layout_marginBottom="@dimen/space_xs"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@string/cd_message_image"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            tools:src="@drawable/bg_image_placeholder"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvMessageContent"
            style="@style/TextAppearance.App.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_sent"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body_lg"
            android:visibility="visible"
            tools:text="Dạ vâng ạ, mai em qua xem nhé" />
    </LinearLayout>
</LinearLayout>