<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_review_card"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Exchange Icon + Title + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_olive">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_swap"
                    android:src="@drawable/ic_swap_horiz"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvExchangeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Căn hộ Thảo Điền" />

                <TextView
                    android:id="@+id/tvExchangePartner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp"
                    tools:text="Đối tác đổi nhà" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvExchangeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_verified"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="✓ Hoàn tất" />

        </LinearLayout>

        <!-- Message/Period Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_comment_box"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvExchangePeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Thời gian: Học kỳ 1 (09/2026 - 01/2027)" />

            <TextView
                android:id="@+id/tvExchangeMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_sub"
                android:textSize="11sp"
                tools:text="Thỏa thuận đổi nhà 2 chiều đã hoàn tất thành công." />

        </LinearLayout>

        <!-- Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layoutPendingActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/btnAcceptExchange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:background="@drawable/bg_button_green"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:drawableStart="@drawable/ic_check"
                    android:drawablePadding="4dp"
                    app:drawableTint="@color/white"
                    android:paddingHorizontal="12dp"
                    android:text="@string/exchange_btn_accept"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRejectExchange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minHeight="40dp"
                    android:background="@drawable/bg_button_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:drawableStart="@drawable/ic_circle_x"
                    android:drawablePadding="4dp"
                    app:drawableTint="@color/status_danger"
                    android:paddingHorizontal="12dp"
                    android:text="@string/exchange_btn_reject"
                    android:textColor="@color/status_danger"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- View Agreement / Contract Button -->
            <TextView
                android:id="@+id/btnViewAgreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="40dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/ic_shield_check"
                android:drawablePadding="4dp"
                app:drawableTint="@color/primary"
                android:paddingHorizontal="8dp"
                android:text="@string/action_view_agreement"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnReviewPartner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/ic_star"
                android:drawablePadding="4dp"
                app:drawableTint="@color/primary"
                android:paddingHorizontal="8dp"
                android:text="@string/exchange_btn_review"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>