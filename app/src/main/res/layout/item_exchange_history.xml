<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_review_card"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/avatar_size_md"
                android:layout_height="@dimen/avatar_size_md"
                android:background="@drawable/bg_circle_olive">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_swap"
                    android:src="@drawable/ic_swap"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvExchangeTitle"
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body_lg"
                    tools:text="Căn hộ Thảo Điền" />

                <TextView
                    android:id="@+id/tvExchangePartner"
                    style="@style/TextAppearance.App.BodySub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textSize="@dimen/text_small_lg"
                    tools:text="Đối tác đổi nhà" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvExchangeStatus"
                style="@style/Widget.App.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_verified"
                android:textColor="@color/primary"
                tools:text="✓ Hoàn tất" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_comment_box"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvExchangePeriod"
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_small_lg"
                tools:text="Thời gian: Học kỳ 1 (09/2026 - 01/2027)" />

            <TextView
                android:id="@+id/tvExchangeMessage"
                style="@style/TextAppearance.App.BodySub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textSize="@dimen/text_small"
                tools:text="Thỏa thuận đổi nhà 2 chiều đã hoàn tất thành công." />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layoutPendingActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/btnAcceptExchange"
                    style="@style/Widget.App.ActionText"
                    android:minHeight="@dimen/touch_target_min"
                    android:gravity="center"
                    android:background="@drawable/bg_button_green"
                    android:drawableStart="@drawable/ic_check"
                    android:drawablePadding="@dimen/space_xs"
                    app:drawableTint="@color/white"
                    android:paddingHorizontal="@dimen/space_md"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_small_lg"
                    android:text="@string/exchange_btn_accept" />

                <TextView
                    android:id="@+id/btnRejectExchange"
                    style="@style/Widget.App.ActionText"
                    android:layout_marginStart="@dimen/space_sm"
                    android:minHeight="@dimen/touch_target_min"
                    android:gravity="center"
                    android:background="@drawable/bg_button_secondary"
                    android:drawableStart="@drawable/ic_close"
                    android:drawablePadding="@dimen/space_xs"
                    app:drawableTint="@color/status_danger"
                    android:paddingHorizontal="@dimen/space_md"
                    android:textColor="@color/status_danger"
                    android:textSize="@dimen/text_small_lg"
                    android:text="@string/exchange_btn_reject" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnViewAgreement"
                style="@style/Widget.App.ActionText"
                android:layout_marginStart="@dimen/space_xs"
                android:drawableStart="@drawable/ic_shield_check"
                app:drawableTint="@color/primary"
                android:paddingHorizontal="@dimen/space_sm"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_small_lg"
                android:text="@string/action_view_agreement" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnReviewPartner"
                style="@style/Widget.App.ActionText"
                android:drawableStart="@drawable/ic_star"
                app:drawableTint="@color/primary"
                android:paddingHorizontal="@dimen/space_sm"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_small_lg"
                android:text="@string/exchange_btn_review" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>