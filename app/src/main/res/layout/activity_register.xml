<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Widget.App.HeaderBar"
        android:paddingHorizontal="@dimen/space_xl"
        android:background="@color/bg_app">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.App.HeaderBackButton"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/Widget.App.HeaderTitle"
            android:gravity="center"
            android:text="@string/register_step1_title" />

        <View
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Field: Họ và Tên Phụ Huynh / Chủ nhà -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilParentName"
                style="@style/Widget.App.FormField"
                android:hint="@string/register_label_name"
                app:startIconDrawable="@drawable/ic_user">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etParentName"
                    style="@style/Widget.App.FormInput"
                    android:autofillHints="name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Field: Số điện thoại -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                style="@style/Widget.App.FormField"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/register_label_phone"
                app:startIconDrawable="@drawable/ic_phone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    style="@style/Widget.App.FormInput"
                    android:autofillHints="phoneNumber"
                    android:imeOptions="actionNext"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Field: Mật khẩu -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.App.FormField"
                android:layout_marginTop="@dimen/space_md"
                android:hint="Mật khẩu"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    style="@style/Widget.App.FormInput"
                    android:autofillHints="password"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Field: Trường Đại Học (Chỉ chọn) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUniversity"
                style="@style/Widget.App.FormField"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/register_label_university"
                app:endIconDrawable="@drawable/ic_chevron_down"
                app:endIconMode="custom"
                app:startIconDrawable="@drawable/ic_graduation_cap">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tvUniversity"
                    style="@style/Widget.App.FormInput"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Điều khoản dịch vụ -->

            <!-- Nút Tiếp Tục -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/register_btn_continue" />
        </LinearLayout>
    </ScrollView>

    <!-- Nút Đã có tài khoản? Đăng nhập -->
</LinearLayout>
