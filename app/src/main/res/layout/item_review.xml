<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- Header: Reviewer Avatar + Name + Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReviewerAvatar"
                android:layout_width="@dimen/avatar_size_sm"
                android:layout_height="@dimen/avatar_size_sm"
                android:background="@drawable/bg_circle_olive"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                tools:text="M" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReviewerName"
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body"
                    tools:text="Hộ gia đình đối tác" />

                <TextView
                    android:id="@+id/tvReviewDate"
                    style="@style/TextAppearance.App.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textSize="@dimen/text_caption"
                    tools:text="15/10/2026 · Học kỳ 1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvReviewRatingStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_xxs"
                android:textColor="@color/status_warning"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                tools:text="★ 5.0" />
        </LinearLayout>

        <!-- Review Comment Box (Dùng LinearLayout thay vì nested MaterialCardView) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_comment_box"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/tvReviewComment"
                style="@style/TextAppearance.App.BodySub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/space_xxs"
                android:textColor="@color/text_main"
                android:textSize="@dimen/text_small_lg"
                tools:text="Gia đình rất uy tín, giữ gìn nhà cửa sạch sẽ và bàn giao đúng hẹn." />
        </LinearLayout>

        <!-- Optional Image Attachment Preview -->
        <HorizontalScrollView
            android:id="@+id/scrollReviewAttachments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/reviewAttachmentsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>