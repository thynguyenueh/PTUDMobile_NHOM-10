<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: Reviewer Avatar + Name + Rating -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvReviewerAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_partner_avatar"
            android:gravity="center"
            android:text="M"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReviewerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gia đình Cô Mai"
                android:textColor="#172033"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReviewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="15/10/2026 · Học kỳ 1"
                android:textColor="#6B7280"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvReviewRatingStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★★★★★"
            android:textColor="#FFC400"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Review Comment -->
    <TextView
        android:id="@+id/tvReviewComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:text="Gia đình rất lịch sự, giữ gìn nhà cửa sạch sẽ chu đáo."
        android:textColor="#374151"
        android:textSize="13sp" />

    <!-- Optional Image Attachment Preview -->
    <ImageView
        android:id="@+id/imgReviewAttachment"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="10dp"
        android:contentDescription="Attached Image"
        android:scaleType="centerCrop"
        android:visibility="gone" />

</LinearLayout>
