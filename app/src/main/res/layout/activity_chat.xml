<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Widget.App.HeaderBar"
        android:paddingVertical="@dimen/space_sm">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.App.HeaderBackButton" />

        <TextView
            android:id="@+id/tvChatAvatarLetter"
            style="@style/Widget.App.AvatarCircle.Large"
            android:layout_marginStart="@dimen/space_sm"
            tools:text="M" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvChatHeaderName"
                    style="@style/TextAppearance.App.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_header_name" />

                <ImageView
                    android:id="@+id/ivVerifiedBadge"
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:layout_marginStart="@dimen/space_xs"
                    android:contentDescription="@string/cd_verified"
                    android:src="@drawable/ic_verified_check"
                    android:visibility="gone"
                    app:tint="@color/primary"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.App.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/chat_active_status" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCall"
            style="@style/Widget.App.IconButton"
            android:contentDescription="@string/cd_call"
            android:src="@drawable/ic_phone"
            app:tint="@color/primary" />
    </LinearLayout>

    <View style="@style/Widget.App.Divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_md"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_md">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/touch_target_min"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="@dimen/space_sm">

            <EditText
                android:id="@+id/etMessageInput"
                style="@style/Widget.App.FormInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/chat_input_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:textColorHint="@color/text_sub" />

            <ImageView
                android:id="@+id/btnAttach"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_marginStart="@dimen/space_sm"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_attach"
                android:focusable="true"
                android:padding="@dimen/space_xs"
                android:src="@drawable/ic_paperclip"
                app:tint="@color/primary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnSend"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/space_md"
            android:background="@drawable/bg_dark_circle_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/icon_display"
                android:layout_height="@dimen/icon_display"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_send"
                android:src="@drawable/ic_send" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>