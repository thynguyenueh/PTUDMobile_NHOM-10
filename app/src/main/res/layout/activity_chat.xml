<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <!-- Top Navigation / Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_sm">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:padding="@dimen/space_md"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_main" />

        <!-- Avatar Letter -->
        <FrameLayout
            android:layout_width="@dimen/avatar_size_lg"
            android:layout_height="@dimen/avatar_size_lg"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_avatar_circle">

            <TextView
                android:id="@+id/tvChatAvatarLetter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"
                tools:text="M" />
        </FrameLayout>

        <!-- User Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvChatHeaderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_header_name"
                    android:textColor="@color/text_main"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/layoutVerifiedBadge"
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:layout_marginStart="@dimen/space_xs"
                    android:contentDescription="@string/cd_verified"
                    android:src="@drawable/ic_verified_check"
                    app:tint="@color/primary"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/chat_active_status"
                android:textColor="@color/text_sub"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- Phone Icon -->
        <ImageView
            android:id="@+id/btnCall"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:padding="@dimen/space_md"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_call"
            android:src="@drawable/ic_phone"
            app:tint="@color/text_main" />
    </LinearLayout>

    <View style="@style/Widget.App.Divider" />

    <!-- RecyclerView for Chat Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_md"
        android:clipToPadding="false" />

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_md">

        <!-- Pill Input Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="@dimen/space_sm">

            <EditText
                android:id="@+id/etMessageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAutofill="no"
                android:background="@null"
                android:hint="@string/chat_input_hint"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub"
                android:textSize="@dimen/text_body_lg" />

            <ImageView
                android:id="@+id/btnAttach"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_marginStart="@dimen/space_sm"
                android:padding="@dimen/space_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_attach"
                android:src="@drawable/ic_paperclip"
                app:tint="@color/text_sub" />
        </LinearLayout>

        <!-- Send Button -->
        <FrameLayout
            android:id="@+id/btnSend"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/space_md"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dark_circle_button">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_send"
                android:src="@drawable/ic_send" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>