<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="96dp"
    android:layout_height="96dp"
    android:layout_marginEnd="@dimen/space_sm">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/cd_photo"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

    <!-- Label "Mặt trước" / "Mặt sau" -->
    <TextView
        android:id="@+id/tvPhotoLabel"
        style="@style/TextAppearance.App.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/space_xs"
        android:background="@drawable/bg_pill_scrim"
        android:paddingHorizontal="@dimen/space_xs"
        android:paddingVertical="@dimen/space_xxs"
        android:textColor="@color/white"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btnRemovePhoto"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/bg_dark_circle_button"
        android:padding="6dp"
        android:src="@drawable/ic_close"
        app:tint="@color/white"
        android:contentDescription="@string/cd_remove_photo" />
</FrameLayout>