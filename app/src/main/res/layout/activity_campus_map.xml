<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fitsSystemWindows="true">

    <!-- Map View / Placeholder Texture -->
    <ImageView
        android:id="@+id/ivMapTexture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@color/bg_input"
        android:importantForAccessibility="no" />

    <!-- Top Floating Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="@dimen/space_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_btn_size"
            android:layout_height="@dimen/icon_btn_size"
            android:background="@drawable/bg_circle_overlay"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            style="@style/Widget.App.Card.Tinted">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="@dimen/space_xs">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:src="@drawable/ic_location"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tvCampusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:textColor="@color/text_main"
                    android:textSize="@dimen/text_small"
                    android:textStyle="bold"
                    tools:text="Khu vực ĐHQG &amp; Thảo Điền (Bán kính 2km)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Bottom Selected House Floating Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSelectedHouse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/space_lg"
        style="@style/Widget.App.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_sm">

            <FrameLayout
                android:layout_width="@dimen/avatar_size_lg"
                android:layout_height="@dimen/avatar_size_lg">

                <ImageView
                    android:id="@+id/ivHouseThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_image_placeholder"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvDistanceBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/bg_pill_scrim"
                    android:paddingHorizontal="@dimen/space_xs"
                    android:paddingVertical="@dimen/space_xxs"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    tools:text="0.8 km" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHousePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_body_lg"
                        android:textStyle="bold"
                        tools:text="3.5 Tr/tháng" />

                    <TextView
                        android:id="@+id/tvHouseArea"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:textColor="@color/text_sub"
                        android:textSize="@dimen/text_small"
                        tools:text="· 45 m²" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHouseTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_main"
                    android:textSize="@dimen/text_body_lg"
                    android:textStyle="bold"
                    tools:text="Căn hộ Studio cao cấp gần ĐH Bách Khoa" />

                <TextView
                    android:id="@+id/tvHouseAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_sub"
                    android:textSize="@dimen/text_small"
                    tools:text="268 Lý Thường Kiệt, Q.10" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs">

                    <TextView
                        android:id="@+id/tvHostName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="@string/detail_host_name"
                        android:textColor="@color/text_sub"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/action_view_detail"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_small"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>