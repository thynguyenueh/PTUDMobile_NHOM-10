<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <LinearLayout style="@style/Widget.App.HeaderBar">
        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.App.HeaderBackButton" />

        <TextView
            style="@style/Widget.App.HeaderTitle"
            android:text="@string/public_host_title" />
    </LinearLayout>

    <View style="@style/Widget.App.Divider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <!-- Profile Info Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <FrameLayout
                        android:layout_width="@dimen/profile_avatar_xl"
                        android:layout_height="@dimen/profile_avatar_xl"
                        android:background="@drawable/bg_circle_olive">

                        <ImageView
                            android:id="@+id/ivHostAvatarImg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:contentDescription="@string/cd_avatar" />

                        <TextView
                            android:id="@+id/tvAvatarInitial"
                            style="@style/Widget.App.AvatarCircle.XLarge"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:textSize="28sp"
                            tools:text="C" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvHostFullName"
                            style="@style/TextAppearance.App.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Gia đình Cô Mai" />

                        <ImageView
                            android:id="@+id/ivPublicHostVerified"
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:layout_marginStart="@dimen/space_xs"
                            android:contentDescription="@string/cd_verified"
                            android:src="@drawable/ic_verified_check"
                            android:visibility="gone"
                            app:tint="@color/primary"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStudentInfo"
                        style="@style/TextAppearance.App.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:textSize="@dimen/text_small_lg"
                        tools:text="Sinh viên ĐH Bách Khoa TP.HCM" />

                    <!-- Verification Trust Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:background="@drawable/bg_badge_verified_moss"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_md"
                        android:paddingVertical="@dimen/space_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@string/cd_shield"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/primary" />

                        <TextView
                            style="@style/TextAppearance.App.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_small"
                            android:textStyle="bold"
                            android:text="@string/public_host_trust_text" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Verification Status List -->
            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/public_host_verification_title" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <!-- Status 1: Thẻ SV -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@string/cd_student_id"
                            android:src="@drawable/ic_school_cap"
                            app:tint="@color/primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.App.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:text="@string/public_host_verify_student" />

                            <TextView
                                style="@style/TextAppearance.App.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/public_host_verify_student_id" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStudentVerifyStatus"
                            style="@style/TextAppearance.App.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            tools:text="Đã xác thực" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.App.Divider"
                        android:layout_marginVertical="@dimen/space_md" />

                    <!-- Status 3: Xác thực CCCD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@string/cd_student_id"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.App.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:text="@string/public_host_verify_cccd_title" />

                            <TextView
                                style="@style/TextAppearance.App.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/public_host_verify_cccd_sub" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCccdVerifyStatus"
                            style="@style/TextAppearance.App.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            tools:text="Đã xác thực" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.App.Divider"
                        android:layout_marginVertical="@dimen/space_md" />

                    <!-- Status 2: Xác thực Công an -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@string/cd_security"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.App.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:text="@string/public_host_verify_police" />

                            <TextView
                                style="@style/TextAppearance.App.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/public_host_verify_police_sub" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPoliceVerifyStatus"
                            style="@style/TextAppearance.App.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            tools:text="Đã xác thực" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Posts Section -->
            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/public_host_house_title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHostPosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:padding="@dimen/space_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChatWithHost"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:text="@string/public_host_btn_chat"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_sm" />
    </LinearLayout>
</LinearLayout>