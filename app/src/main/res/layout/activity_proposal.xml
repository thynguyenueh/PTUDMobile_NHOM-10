<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_xl">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:padding="@dimen/space_md"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_main" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/proposal_title"
            android:textColor="@color/text_main"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold" />
    </LinearLayout>

    <View style="@style/Widget.App.Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <!-- Two homes -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideCenter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <include
                    android:id="@+id/cardMyHome"
                    layout="@layout/item_home_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    app:layout_constraintEnd_toStartOf="@id/guideCenter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <include
                    android:id="@+id/cardPartnerHome"
                    layout="@layout/item_home_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/guideCenter"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="@dimen/avatar_size_md"
                    android:layout_height="@dimen/avatar_size_md"
                    android:background="@drawable/bg_circle_olive"
                    android:contentDescription="@string/cd_swap"
                    android:elevation="@dimen/elevation_med"
                    android:padding="@dimen/space_sm"
                    android:src="@drawable/ic_swap"
                    app:tint="@color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/guideCenter"
                    app:layout_constraintStart_toStartOf="@id/guideCenter"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Period -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:text="@string/proposal_period_title"
                android:textColor="@color/text_main"
                android:textSize="@dimen/text_body_lg"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:checkedButton="@id/btnSemester1"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSemester1"
                    style="@style/Widget.App.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/proposal_period_semester_1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSemester2"
                    style="@style/Widget.App.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/proposal_period_semester_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFullYear"
                    style="@style/Widget.App.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/proposal_period_full_year" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Message -->
            <TextView
                android:id="@+id/tvMessageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:textColor="@color/text_main"
                android:textSize="@dimen/text_body_lg"
                android:textStyle="bold"
                tools:text="Lời nhắn cho Hộ gia đình đối tác" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMessage"
                style="@style/Widget.App.FormField"
                android:layout_marginTop="@dimen/space_md"
                app:counterEnabled="true"
                app:counterMaxLength="300">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMessage"
                    style="@style/Widget.App.FormInput"
                    android:gravity="top|start"
                    android:hint="@string/proposal_message_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Privacy note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/proposal_privacy_note"
                    android:textColor="@color/text_sub"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSend"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height"
        android:layout_margin="@dimen/space_xl"
        android:text="@string/proposal_send" />
</LinearLayout>