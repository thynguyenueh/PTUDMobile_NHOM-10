<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/surface_card">

    <EditText
        android:id="@+id/etSearchUniversity"
        style="@style/Widget.App.FormInput"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_bar_height"
        android:background="@drawable/bg_search_bar"
        android:hint="@string/search_university_hint"
        android:importantForAutofill="no"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:textSize="@dimen/text_body_lg"
        android:inputType="text"
        android:singleLine="true" />

    <ListView
        android:id="@+id/lvUniversities"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="@dimen/space_md"
        android:divider="@color/divider_line"
        android:dividerHeight="1dp"
        tools:listitem="@android:layout/simple_list_item_1" />

</LinearLayout>