<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutHeader"
        style="@style/Widget.App.HeaderBar">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.App.HeaderBackButton" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/Widget.App.HeaderTitle"
            android:text="@string/exchange_history_title" />

        <TextView
            android:id="@+id/tvTotalExchanges"
            style="@style/TextAppearance.App.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            tools:text="0 lượt" />
    </LinearLayout>

    <View style="@style/Widget.App.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupExchangeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:chipSpacingHorizontal="@dimen/space_xs"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipExchangeAll"
                style="@style/Widget.App.Chip"
                android:checked="true"
                android:text="@string/exchange_filter_all" />
            <com.google.android.material.chip.Chip android:id="@+id/chipExchangePending" style="@style/Widget.App.Chip" android:text="@string/exchange_filter_pending" />
            <com.google.android.material.chip.Chip android:id="@+id/chipExchangeApproved" style="@style/Widget.App.Chip" android:text="@string/exchange_filter_approved" />
            <com.google.android.material.chip.Chip android:id="@+id/chipExchangeCompleted" style="@style/Widget.App.Chip" android:text="@string/exchange_filter_completed" />
            <com.google.android.material.chip.Chip android:id="@+id/chipExchangeClosed" style="@style/Widget.App.Chip" android:text="@string/exchange_filter_closed" />
        </com.google.android.material.chip.ChipGroup>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExchangeHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_weight="1" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/containerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_card"
            android:padding="@dimen/space_lg">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateProposal"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:text="@string/exchange_btn_create_proposal" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>