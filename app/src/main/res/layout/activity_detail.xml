<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================= PHOTO GALLERY (hero) ================= -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/photoPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_gradient_top" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_gradient_bottom" />

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_circle_overlay"
                    android:contentDescription="@string/cd_back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_circle_overlay"
                    android:contentDescription="@string/cd_favorite"
                    android:padding="10dp"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="16dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/tvVerifiedBadge"
                        android:layout_width="@dimen/icon_sm"
                        android:layout_height="@dimen/icon_sm"
                        android:contentDescription="@string/cd_verified"
                        android:src="@drawable/ic_verified_check"
                        android:visibility="gone"
                        app:tint="@color/primary"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_scrim"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Còn trống kỳ mới" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPhotoCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_pill_scrim"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    tools:text="1 / 3" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/photoIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@android:color/transparent"
                    app:tabBackground="@drawable/tab_dot_selector"
                    app:tabGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabMaxWidth="14dp"
                    app:tabMinWidth="14dp"
                    app:tabPaddingEnd="2dp"
                    app:tabPaddingStart="2dp"
                    app:tabPaddingTop="0dp"
                    app:tabPaddingBottom="0dp"
                    app:tabRippleColor="@android:color/transparent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ================= GIÁ TO & LOẠI CHỖ Ở ================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPriceBig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        tools:text="3.5 Tr" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/detail_month_suffix"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHouseType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Căn hộ" />
                </LinearLayout>

                <!-- ================= TIÊU ĐỀ ================= -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/detail_title"
                    android:textColor="@color/text_main"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- ================= META DIỆN TÍCH ================= -->
                <TextView
                    android:id="@+id/tvAreaMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp"
                    tools:text="Diện tích sử dụng: 45 m² · Đã qua thẩm định" />

                <!-- ================= ĐỊA CHỈ ================= -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_location"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/detail_location"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- ================= HOST CARD ================= -->
                <include layout="@layout/layout_host_card" />

                <!-- ================= DISTANCE CARD ================= -->
                <include layout="@layout/layout_distance_card" />

                <!-- ================= MÔ TẢ KHÔNG GIAN SỐNG ================= -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/detail_desc_label"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider_line"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:padding="14dp"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        tools:text="Căn hộ rộng rãi, thoáng mát, đầy đủ tiện nghi, phù hợp cho sinh viên và hộ gia đình nhỏ. Môi trường an ninh, yên tĩnh, thuận tiện đi lại đến các trường đại học." />
                </com.google.android.material.card.MaterialCardView>

                <!-- ================= TIỆN ÍCH (grid) ================= -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/detail_amenities"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:id="@+id/gridAmenities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:columnCount="2" />

                <TextView
                    android:id="@+id/tvAmenitiesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/detail_amenities_empty"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Safety Note Banner: removed missing layout include -->

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ================= BOTTOM BAR (floating card) ================= -->
    <include layout="@layout/layout_detail_bottom_bar" />
</LinearLayout>