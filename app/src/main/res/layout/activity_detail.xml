<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_image_height_lg">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/photoPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_gradient_top" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_gradient_bottom" />

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.App.IconButton.Overlay"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/space_lg"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_arrow_back" />

                <ImageButton
                    android:id="@+id/btnFavorite"
                    style="@style/Widget.App.IconButton.Overlay"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/space_lg"
                    android:contentDescription="@string/cd_favorite"
                    android:src="@drawable/ic_favorite_border" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="@dimen/space_lg"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        style="@style/Widget.App.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:background="@drawable/bg_pill_red"
                        android:textColor="@color/status_danger"
                        android:visibility="gone"
                        tools:text="@string/status_exchanged" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPhotoCounter"
                    style="@style/Widget.App.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="@dimen/space_lg"
                    android:background="@drawable/bg_pill_scrim"
                    android:textColor="@color/white"
                    tools:text="1 / 3" />

                <!-- ✅ LinearLayout thay cho TabLayout cũ -->
                <LinearLayout
                    android:id="@+id/photoIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/space_md"
                    android:orientation="horizontal" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/TextAppearance.App.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/detail_title" />

                <TextView
                    android:id="@+id/tvAreaMeta"
                    style="@style/TextAppearance.App.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:drawablePadding="@dimen/space_xs"
                    android:textSize="@dimen/text_small_lg"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_verified_check"
                    app:drawableTint="@color/primary"
                    tools:text="@string/post_address_verified"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_sm"
                        android:layout_height="@dimen/icon_sm"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_location"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tvLocation"
                        style="@style/TextAppearance.App.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:text="@string/detail_location" />
                </LinearLayout>

                <include layout="@layout/layout_host_card" />

                <include layout="@layout/layout_distance_card" />

                <TextView
                    android:id="@+id/tvDescriptionLabel"
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:textSize="@dimen/text_body_lg2"
                    android:text="@string/detail_desc_label" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDescription"
                    style="@style/Widget.App.Card.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvDescription"
                        style="@style/TextAppearance.App.BodySub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:padding="14dp"
                        tools:text="Căn hộ rộng rãi, thoáng mát..." />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:textSize="@dimen/text_body_lg2"
                    android:text="@string/detail_amenities" />

                <GridLayout
                    android:id="@+id/gridAmenities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:columnCount="2" />

                <TextView
                    android:id="@+id/tvAmenitiesEmpty"
                    style="@style/TextAppearance.App.BodySub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/detail_amenities_empty"
                    android:visibility="gone" />

                <!-- Khu vực Bình luận -->
                <TextView
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:textSize="@dimen/text_body_lg2"
                    android:text="Bình luận" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <EditText
                            android:id="@+id/etCommentInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_edittext"
                            android:padding="@dimen/space_md"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/text_main"
                            android:hint="Viết bình luận của bạn..."
                            android:inputType="textMultiLine"
                            android:maxLines="3"
                            android:minLines="2" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitComment"
                            style="@style/Widget.App.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/touch_target_min"
                            android:layout_gravity="end"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="Gửi bình luận" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvCommentsEmpty"
                    style="@style/TextAppearance.App.BodySub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Chưa có bình luận nào cho bài đăng này."
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_detail_bottom_bar" />
</LinearLayout>