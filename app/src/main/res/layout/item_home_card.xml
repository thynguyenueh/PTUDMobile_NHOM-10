<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card.Moss"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="112dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivHomePhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_photo"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_image_placeholder"
                app:shapeAppearance="@style/ShapeAppearance.App.Image12" />

            <ImageView
                android:id="@+id/ivHomeVerified"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_sm"
                android:background="@drawable/bg_badge_verified"
                android:contentDescription="@string/cd_verified"
                android:padding="@dimen/space_xs"
                android:src="@drawable/ic_verified_check"
                android:visibility="gone"
                app:tint="@color/primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvHomeLabel"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:textSize="@dimen/text_small"
            android:textColor="@color/primary"
            android:textStyle="bold"
            tools:text="NHÀ CỦA BẠN" />

        <TextView
            android:id="@+id/tvHomeName"
            style="@style/TextAppearance.App.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/text_body_lg2"
            tools:text="Căn hộ Studio Thảo Điền" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>