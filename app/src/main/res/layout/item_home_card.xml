<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/light_moss"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="112dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivHomePhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_photo"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_image_placeholder"
                app:shapeAppearance="@style/ShapeAppearance.App.Image12" />

            <ImageView
                android:id="@+id/tvHomeVerified"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_badge_verified"
                android:padding="4dp"
                android:contentDescription="@string/cd_verified"
                android:src="@drawable/ic_verified_check"
                app:tint="@color/primary"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="NHÀ CỦA BẠN" />

        <TextView
            android:id="@+id/tvHomeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Căn hộ Studio Thảo Điền" />

        <TextView
            android:id="@+id/tvHomePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="3.5 Tr/tháng" />

        <TextView
            android:id="@+id/tvHomeArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            tools:text="45 m²" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>