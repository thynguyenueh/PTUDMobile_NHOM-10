<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        style="@style/Widget.App.HeaderBar">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.App.HeaderBackButton" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/Widget.App.HeaderTitle"
            android:text="@string/my_posts_title" />

        <TextView
            android:id="@+id/tvTotalPosts"
            style="@style/TextAppearance.App.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            tools:text="0 bài đăng" />
    </LinearLayout>

    <View
        android:id="@+id/dividerHeader"
        style="@style/Widget.App.Divider"
        android:layout_below="@id/layoutHeader" />

    <!-- Content Slot -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMyPosts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerHeader"
        android:clipToPadding="false"
        android:padding="@dimen/space_lg" />

    <LinearLayout
        android:id="@+id/layoutMyPostsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/dividerHeader"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="@dimen/space_xxl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            style="@style/TextAppearance.App.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/my_posts_empty_title" />

        <TextView
            style="@style/TextAppearance.App.BodySub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/my_posts_empty_desc" />
    </LinearLayout>

    <!-- Extended Floating Action Button -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnCreatePost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/space_xxl"
        android:text="@string/my_posts_btn_create"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white" />

</RelativeLayout>