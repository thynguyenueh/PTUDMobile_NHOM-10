<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <LinearLayout style="@style/Widget.App.HeaderBar">
        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.App.HeaderBackButton" />

        <TextView
            style="@style/Widget.App.HeaderTitle"
            android:text="@string/residence_verification_title" />

        <ImageView
            android:id="@+id/btnHelp"
            style="@style/Widget.App.HeaderBackButton"
            android:contentDescription="@string/cd_help"
            android:src="@drawable/ic_help"
            app:tint="@color/primary" />
    </LinearLayout>

    <View style="@style/Widget.App.Divider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Verification Status Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_banner_green"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/residence_verification_banner"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Upload Section -->
            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="Tải lên giấy tờ xác thực" />

            <TextView
                style="@style/TextAppearance.App.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:layout_marginBottom="@dimen/space_md"
                android:text="Giấy xác nhận cư trú (Mẫu CT07) hoặc QR VNeID" />

            <!-- Dashed Upload Box -->
            <LinearLayout
                android:id="@+id/layoutUploadBox"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:background="@drawable/bg_upload_dashed"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="@dimen/icon_xl"
                    android:layout_height="@dimen/icon_xl"
                    android:contentDescription="@string/cd_camera"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tvUploadText"
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/primary"
                    android:text="Bấm để chọn ảnh hoặc tệp" />
            </LinearLayout>

            <!-- Detailed Address Section -->
            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="Địa chỉ chi tiết" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDetailedAddress"
                style="@style/Widget.App.FormField"
                android:layout_marginTop="@dimen/space_xs"
                android:hint="Số nhà, tên đường, Phường/Xã, Quận/Huyện"
                app:startIconDrawable="@drawable/ic_location">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDetailedAddress"
                    style="@style/Widget.App.FormInput"
                    android:inputType="textPostalAddress"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:padding="@dimen/space_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitVerification"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:text="@string/residence_verification_btn_submit"
            app:icon="@drawable/ic_shield_check"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_sm" />
    </LinearLayout>

</LinearLayout>
