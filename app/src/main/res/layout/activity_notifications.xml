<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout style="@style/Widget.App.HeaderBar">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.App.HeaderBackButton"
            android:contentDescription="@string/cd_back" />

        <TextView
            style="@style/TextAppearance.App.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:text="@string/notifications_title" />

        <ImageView
            android:id="@+id/btnRefreshNotifications"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Làm mới"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/primary" />
    </LinearLayout>

    <View style="@style/Widget.App.Divider" />

    <TextView
        android:id="@+id/tvNotificationState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_md"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/space_lg"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>