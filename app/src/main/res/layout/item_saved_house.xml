<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_sm"
    android:layout_marginBottom="@dimen/space_md"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <!-- Thumbnail -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            style="@style/Widget.App.Card.Outlined"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivSavedPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_photo"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/bg_image_placeholder" />

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSavedTitle"
                    style="@style/TextAppearance.App.Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Căn hộ mini cao cấp gần ĐHQG" />

                <ImageView
                    android:id="@+id/tvSavedVerified"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/space_xs"
                    android:contentDescription="@string/cd_verified"
                    android:src="@drawable/ic_verified"
                    app:tint="@color/primary"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btnRemoveSaved"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_unsave"
                    android:padding="6dp"
                    android:src="@drawable/ic_favorite" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSavedAddress"
                style="@style/TextAppearance.App.BodySub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Phường Linh Trung, Thủ Đức" />

            <TextView
                android:id="@+id/tvSavedDistance"
                style="@style/TextAppearance.App.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:drawablePadding="@dimen/space_xs"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_graduation_cap"
                app:drawableTint="@color/primary"
                tools:text="Gần ĐHQG TP.HCM · ~1,5 km"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
